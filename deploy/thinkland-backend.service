[Unit]
Description=ThinkLand FastAPI Backend
After=network.target mysql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/www/thinkland/consumer-backend
EnvironmentFile=/www/thinkland/consumer-backend/.env
ExecStart=/www/thinkland/consumer-backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
